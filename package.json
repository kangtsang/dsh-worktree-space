{
  "name": "dsh-worktree-space",
  "version": "1.0.8",
  "description": "Worktree Space: one task can span one or more Git repositories - under one task space directory, every repository gets its own worktree on one shared task branch, and the task space is registered as an agent Workspace where its sessions start. Tasks run in parallel without interfering with one another; finishing one merges it back into each repository's current branch, and the worktree branches and the task space are cleaned up on request.",
  "icon": "./icon.svg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kangtsang/dsh-worktree-space.git"
  },
  "homepage": "https://github.com/kangtsang/dsh-worktree-space#readme",
  "bugs": "https://github.com/kangtsang/dsh-worktree-space/issues",
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "git",
    "worktree",
    "multi-repo"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.1.7-alpha.2 <0.3.0-0"
  },
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/en.json": "./locale/en.json",
    "./locale/zh.json": "./locale/zh.json"
  },
  "files": [
    "lib",
    "client",
    "assets",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "package.json",
    "CHANGELOG.en.md",
    "CHANGELOG.md",
    "PERMISSIONS.en.md",
    "PERMISSIONS.md",
    "README.en.md",
    "README.md",
    "docs/store-evidence.md",
    "docs/store-evidence.json",
    "docs/img/new-session.png",
    "docs/img/finish-task.png",
    "docs/img/manage-worktree-space.png",
    "docs/img/new-worktree-space.png"
  ],
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "check:client-bundle": "node scripts/check-client-bundle.mjs",
    "check:tracked-bundle": "node scripts/check-tracked-bundle.mjs",
    "check:package": "node scripts/check-package-contents.mjs",
    "test": "pnpm build && pnpm typecheck && pnpm test:unit && pnpm check:client-bundle && pnpm check:tracked-bundle && pnpm check:package",
    "prepublishOnly": "pnpm test"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-client-connection": ">=0.1.7-alpha.2 <0.3.0-0",
    "@deepseek-ai/dsh-tools": ">=0.1.7-alpha.2 <0.3.0-0",
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-api-session-controller"
      ],
      "platform": "web"
    },
    "compatibility": {
      "dsh": ">=0.1.7-alpha.2 <0.3.0-0",
      "node": ">=22.19.0",
      "profiles": [
        "web"
      ],
      "dshReleases": {
        "0.1.7-alpha.2": "compatible",
        "0.1.7-rc.1": "compatible",
        "0.1.7-rc.2": "compatible",
        "0.2.0-rc.1": "compatible",
        "0.2.0-rc.2": "compatible"
      },
      "dshOperations": {
        "0.1.7-alpha.2": {
          "install": "passed",
          "start": "passed",
          "uninstall": "passed",
          "rollback": "passed"
        },
        "0.1.7-rc.1": {
          "install": "passed",
          "start": "passed",
          "uninstall": "passed",
          "rollback": "passed"
        },
        "0.1.7-rc.2": {
          "install": "passed",
          "start": "passed",
          "uninstall": "passed",
          "rollback": "passed"
        },
        "0.2.0-rc.1": {
          "install": "passed",
          "start": "passed",
          "uninstall": "passed",
          "rollback": "passed"
        },
        "0.2.0-rc.2": {
          "install": "passed",
          "start": "passed",
          "uninstall": "passed",
          "rollback": "passed"
        }
      }
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-api-session-controller": "0.2.0-rc.2",
    "@deepseek-ai/dsh-api-workspace-controller": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-connection": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-workspace": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "^3.18.2",
    "@hugeicons/core-free-icons": "4.3.5",
    "@hugeicons/react": "1.1.10",
    "@radix-ui/react-dialog": "1.1.6",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.5",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "esbuild": "^0.28.2",
    "jsdom": "^26.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vitest": "^3.2.7"
  }
}
